# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase / Postgres connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# ABS Data API base (no key required for the base Data API beta)
ABS_API_BASE=https://data.api.abs.gov.au/rest

# CDR product API version header — check individual bank docs if this fails
CDR_API_VERSION=3
